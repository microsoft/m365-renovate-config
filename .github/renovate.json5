{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>microsoft/m365-renovate-config",
    "github>microsoft/m365-renovate-config:groupActions",
    "github>microsoft/m365-renovate-config:keepFresh"
  ],

  "ignorePresets": [
    // Automatically make PRs for major version updates
    "github>microsoft/m365-renovate-config:dependencyDashboardMajor"
  ],

  "labels": ["renovate"],

  "lockFileMaintenance": {
    "automerge": true,
    "platformAutomerge": true,
    "schedule": ["before 5am on the 1st day of the month"]
  },

  "semanticCommits": "disabled",

  "packageRules": [
    {
      // Group updates of all dev deps
      "groupName": "devDependencies",
      "matchPackageNames": ["*"],
      "matchUpdateTypes": ["minor", "patch"],
      "schedule": ["before 5am on the 1st day of the month"]
    }
  ]
}
